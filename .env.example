APP_NAME=КПРМ
# Локално: APP_ENV=local, APP_DEBUG=true
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kprm.gov.rs
# Прима обавештења о безбедносним догађајима (пријава са неуобичајене локације)
ADMIN_EMAIL=

APP_LOCALE=sr_Cyrl
APP_FALLBACK_LOCALE=sr_Cyrl
APP_FAKER_LOCALE=en_US

# Времена се у бази чувају у UTC (config/app.php: timezone), а приказују у овој зони.
APP_DISPLAY_TIMEZONE=Europe/Belgrade

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `daily` ротира логове по дану; `single` је један фајл који неограничено расте
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Локално: debug
LOG_LEVEL=warning

# Апликација користи MySQL синтаксу (DATEDIFF, YEAR) — sqlite није подржан
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kprm
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=7200
# Сесије се чувају у бази и садрже хеш лозинке — шифровање држи укљученo
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true чим апликација ради преко HTTPS-а
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="kprm.no-reply@suk.gov.rs"
MAIL_FROM_NAME="Служба за управљање кадровима"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
